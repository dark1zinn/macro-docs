# Macro self-host settings. Copy to `.env` next to docker-compose.yml (this
# directory, selfhost/), or set these in your platform's environment
# (Coolify). Secrets are generated on first start; nothing secret belongs in
# this file except your SMTP and integration credentials.

# ============================================================================
# Required: set these before the first start. The stack refuses to start
# without the URL, mail domain and SMTP host; the rest of the SMTP settings
# have defaults most providers need changed.
# ============================================================================

# The public origin users open, without a trailing slash. Must be HTTPS
# (session cookies are Secure); http://localhost:<port> works for a local try.
MACRO_PUBLIC_URL=https://macro.example.com

# Domain mail is sent from (login codes, invites): noreply@MACRO_MAIL_DOMAIN.
MACRO_MAIL_DOMAIN=example.com

# Your SMTP provider; the stack relays all mail, login codes included, through
# it. Most providers also need the port, credentials and TLS level below.
SMTP_RELAY_HOST=smtp.example.com
SMTP_RELAY_PORT=587
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
# encrypt (STARTTLS required), may (opportunistic) or none.
SMTP_RELAY_TLS_LEVEL=encrypt
#
# No SMTP provider yet? Enable the `mailcatcher` profile below and use
# SMTP_RELAY_HOST=mailpit, SMTP_RELAY_PORT=1025, SMTP_RELAY_TLS_LEVEL=may;
# mail then lands in the inbox at http://127.0.0.1:8025 (MAILPIT_PORT).

# ============================================================================
# Optional
# ============================================================================

# --- Features ---------------------------------------------------------------

# Optional feature groups, comma-separated:
#   search         full-text indexing (OpenSearch itself always runs: ~1 GB RAM, host needs vm.max_map_count=262144)
#   ai             AI document editing (set your model API keys below)
#   email          Gmail and Google Calendar (needs GOOGLE_CLIENT_ID/SECRET)
#   sso            Google/GitHub sign-in (needs MACRO_AUTH_DOMAIN)
#   whatsapp       WhatsApp linked devices
#   slack          Slack import worker
#   https          automatic Let's Encrypt TLS on 80/443 (not with Coolify)
#   mailcatcher    keep all mail in a local inbox instead of sending it (testing)
#   observability  traces, logs and metrics in Grafana at http://127.0.0.1:3001
# COMPOSE_PROFILES=search,ai

# --- AI model providers -----------------------------------------------------

# Agents, chat and AI editing need at least one. Model pickers only offer the
# providers set here; run `docker compose up -d` after changing them.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# FIREWORK_API_KEY=
# CEREBRAS_API_KEY=
# COHERE_API_KEY=
# Managed agent sandboxes.
# DAYTONA_API_KEY=

# --- Gateway ----------------------------------------------------------------

# The only published port. Behind Coolify or another proxy on the same host,
# bind to 127.0.0.1 (or leave the domain routing to the proxy).
# MACRO_HTTP_BIND=0.0.0.0
# MACRO_HTTP_PORT=8080

# `https` profile: the domain to request a certificate for (MACRO_PUBLIC_URL's host).
# MACRO_DOMAIN=macro.example.com

# --- Sign-in with Google or GitHub (`sso` and `email`) ----------------------

# A second hostname pointing at the gateway, serving FusionAuth's OAuth pages,
# and its public URL.
# MACRO_AUTH_DOMAIN=auth.macro.example.com
# MACRO_AUTH_PUBLIC_URL=https://auth.macro.example.com
# Google OAuth client; the secret starts with GOCSPX-.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET_KEY=
# GitHub OAuth app.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Identity ---------------------------------------------------------------

# FusionAuth admin account (UI is not published; see README.md).
# FUSIONAUTH_ADMIN_EMAIL=admin@example.com
# MACRO_JWT_ISSUER=macro-selfhost

# --- Observability ----------------------------------------------------------

# Off by default: nothing is exported anywhere. With the `observability`
# profile, point the services at its collector:
# MACRO_OTEL_GRPC_ENDPOINT=http://otel-lgtm:4317
# MACRO_OTEL_HTTP_ENDPOINT=http://otel-lgtm:4318
# Or at your own OTLP collector (gRPC for the Rust services, HTTP for workers).
# GRAFANA_PORT=3001

# --- Images -----------------------------------------------------------------

# MACRO_IMAGE_PREFIX=ghcr.io/dark1zinn/macro-selfhost
# MACRO_VERSION=main

# --- Tuning -----------------------------------------------------------------

# OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# POSTGRES_MAX_CONNECTIONS=300
# FUSIONAUTH_MEMORY=512M
# Image builds (docker-compose.build.yml): parallel rustc jobs, default all cores.
# CARGO_BUILD_JOBS=4
