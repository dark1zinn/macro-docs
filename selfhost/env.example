# Macro self-host settings. Copy to `.env` at the repository root (next to
# docker-compose.yml) or set these in your platform's environment (Coolify).
# Secrets are generated on first start; nothing secret belongs in this file
# except your SMTP and integration credentials.

# --- Required ---------------------------------------------------------------

# The public origin users open, without a trailing slash. Must be HTTPS
# (session cookies are Secure); http://localhost:<port> works for a local try.
MACRO_PUBLIC_URL=https://macro.example.com

# Domain mail is sent from (login codes, invites): noreply@MACRO_MAIL_DOMAIN.
MACRO_MAIL_DOMAIN=example.com

# Your SMTP provider; the stack relays all mail through it.
SMTP_RELAY_HOST=smtp.example.com
# SMTP_RELAY_PORT=587
# SMTP_RELAY_USERNAME=
# SMTP_RELAY_PASSWORD=
# encrypt (STARTTLS required), may (opportunistic) or none.
# SMTP_RELAY_TLS_LEVEL=encrypt

# --- Features ---------------------------------------------------------------

# Optional feature groups, comma-separated:
#   search    full-text search (OpenSearch, ~1 GB RAM; host needs vm.max_map_count=262144)
#   ai        agents, AI chat and editing (set your model API keys below)
#   email     Gmail and Google Calendar (needs GOOGLE_CLIENT_ID/SECRET)
#   sso       Google/GitHub sign-in (needs MACRO_AUTH_DOMAIN)
#   whatsapp  WhatsApp linked devices
#   slack     Slack import worker
#   https     automatic Let's Encrypt TLS on 80/443 (not with Coolify)
# COMPOSE_PROFILES=search,ai

# --- Gateway ----------------------------------------------------------------

# The only published port. Behind Coolify or another proxy on the same host,
# bind to 127.0.0.1 (or leave the domain routing to the proxy).
# MACRO_HTTP_BIND=0.0.0.0
# MACRO_HTTP_PORT=8080

# `https` profile: the domain to request a certificate for (MACRO_PUBLIC_URL's host).
# MACRO_DOMAIN=macro.example.com

# `sso` profile: a second hostname pointing at the gateway, serving FusionAuth's
# OAuth pages, and its public URL.
# MACRO_AUTH_DOMAIN=auth.macro.example.com
# MACRO_AUTH_PUBLIC_URL=https://auth.macro.example.com

# --- Identity ---------------------------------------------------------------

# FusionAuth admin account (UI is not published; see selfhost/README.md).
# FUSIONAUTH_ADMIN_EMAIL=admin@example.com
# MACRO_JWT_ISSUER=macro-selfhost

# --- Integrations -----------------------------------------------------------

# Model providers (`ai` profile).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# FIREWORK_API_KEY=
# COHERE_API_KEY=
# CEREBRAS_API_KEY=
# Managed agent sandboxes.
# DAYTONA_API_KEY=

# Google OAuth client (`email` and `sso`); the secret starts with GOCSPX-.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET_KEY=
# GitHub OAuth app (`sso`).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Images -----------------------------------------------------------------

# MACRO_IMAGE_PREFIX=ghcr.io/dark1zinn/macro-selfhost
# MACRO_VERSION=development

# --- Tuning -----------------------------------------------------------------

# OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# POSTGRES_MAX_CONNECTIONS=300
# FUSIONAUTH_MEMORY=512M
